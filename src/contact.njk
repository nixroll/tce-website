{# Form - L (node 937:4840). Форма пока НИКУДА не отправляется (по
   прямой просьбе пользователя) — только клиентская "заглушка успеха":
   contact-form.js перехватывает submit, гасит его (preventDefault),
   если обязательные поля/чекбокс прошли нативную HTML5-валидацию —
   меняет текст кнопки на "Отправлено" и блокирует кнопку от повторной
   отправки. Поле "Документы" — реальный <input type="file"> (открывает
   системный пикер), визуально спрятан, стилизованная обёртка —
   <label>; contact-form.js подставляет имя выбранного файла вместо
   плейсхолдера "Загрузить документ". Чекбокс — тоже настоящий <input
   type="checkbox">, спрятан визуально, состояние Selected из Figma
   (заливка var(--brand) + белая галочка) через :checked + sibling в
   CSS — доступно с клавиатуры, не просто div с JS. #}
<section class="form" data-figma-node="937:4840" data-figma-name="Form - L">
  <div class="form__container">
    <div class="form__intro">
      <div class="form__intro-inner">
        <span class="form__badge">Форма</span>
        <h2 class="form__heading">
          <span class="form__heading-accent">Есть вопрос?</span><br>
          <span class="form__heading-muted">Оставьте заявку.</span>
        </h2>
      </div>
    </div>

    <div class="form__content">
      <form class="form__form" id="contact-form" novalidate>
        <div class="form__fields">
          <div class="form__row">
            <div class="form__field">
              <span class="form__label">
                <span>Имя</span><span class="form__required">*</span>
              </span>
              <span class="form__input">
                <input class="form__input-field" type="text" name="name" placeholder="Имя" autocomplete="name" required>
              </span>
            </div>
            <div class="form__field">
              <span class="form__label">
                <span>Телефон</span><span class="form__required">*</span>
              </span>
              <span class="form__input">
                <input class="form__input-field" type="tel" name="phone" placeholder="+375 (29) 000-00-00" autocomplete="tel" required>
              </span>
            </div>
          </div>

          <div class="form__field">
            <span class="form__label"><span>Email</span></span>
            <span class="form__input">
              <input class="form__input-field" type="email" name="email" placeholder="you@company.com" autocomplete="email">
            </span>
          </div>

          <div class="form__field">
            <span class="form__label">
              <span>Сообщение</span><span class="form__required">*</span>
            </span>
            <textarea class="form__textarea" name="message" placeholder="Оставьте нам сообщение..." required></textarea>
          </div>

          <div class="form__field">
            <span class="form__label"><span>Документы</span></span>
            <label class="form__input form__file-trigger">
              <svg class="form__file-icon" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M16.6666 8.74996V5.66663C16.6666 4.26649 16.6666 3.56643 16.3942 3.03165C16.1545 2.56124 15.772 2.17879 15.3016 1.93911C14.7668 1.66663 14.0668 1.66663 12.6666 1.66663H7.33331C5.93318 1.66663 5.23312 1.66663 4.69834 1.93911C4.22793 2.17879 3.84548 2.56124 3.6058 3.03165C3.33331 3.56643 3.33331 4.26649 3.33331 5.66663V14.3333C3.33331 15.7334 3.33331 16.4335 3.6058 16.9683C3.84548 17.4387 4.22793 17.8211 4.69834 18.0608C5.23312 18.3333 5.93318 18.3333 7.33331 18.3333H9.99998M11.6666 9.16663H6.66665M8.33331 12.5H6.66665M13.3333 5.83329H6.66665M15 17.5V12.5M12.5 15H17.5" stroke="currentColor" stroke-width="1.67" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span class="form__file-text" data-empty-text="Загрузить документ">Загрузить документ</span>
              <input class="visually-hidden" type="file" name="document">
            </label>
          </div>

          <label class="form__checkbox-row">
            <span class="form__checkbox-pad">
              <input class="form__checkbox-input visually-hidden" type="checkbox" name="consent" required>
              <span class="form__checkbox-box" aria-hidden="true">
                <svg class="form__checkbox-check" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M3 7.3L5.8 10L11 4" stroke="white" stroke-width="1.67" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </span>
            <span class="form__checkbox-label">Вы соглашаетесь с <a class="form__checkbox-link" href="{{ '/privacy/' | url }}">политикой конфиденциальности</a>.</span>
          </label>
        </div>

        <button class="btn form__submit" type="submit" data-default-text="Отправить" data-success-text="Отправлено">Отправить</button>
      </form>
    </div>
  </div>
</section>

