# Настройки веб-сервера Apache для thermoconcept.by (hoster.by, тариф
# "Лайт"). Файл лежит в корне сайта рядом с index.html и подхватывается
# сервером автоматически — перезагружать ничего не нужно.
#
# ВАЖНО: файл начинается с точки, поэтому в файловом менеджере панели он
# может быть не виден — включите показ скрытых файлов, если понадобится
# его открыть.

RewriteEngine On


# --------------------------------------------------------------------
# 1. ВКЛЮЧИТЬ ПОСЛЕ ВЫПУСКА SSL-СЕРТИФИКАТА
# --------------------------------------------------------------------
# Переадресация http -> https. Пока сертификат не выпущен, включать
# НЕЛЬЗЯ: сервер будет отправлять посетителя на https, которого ещё нет,
# и сайт станет недоступен вообще (браузер покажет ошибку соединения, а
# не просто "небезопасно").
#
# Порядок такой: загрузили файлы -> привязали домен -> выпустили
# Let's Encrypt в разделе "Безопасность" панели -> убедились, что
# https://thermoconcept.by открывается -> и только тогда убрали решётки
# в начале четырёх строк ниже.
#
# Проверяются два признака сразу: %{HTTPS} и заголовок
# X-Forwarded-Proto. На хостинге перед Apache стоит Nginx, и до Apache
# запрос доходит уже расшифрованным — то есть %{HTTPS} может показывать
# "выключено" даже при работающем https. Без второй проверки это дало бы
# бесконечный цикл переадресаций.
#
# RewriteCond %{HTTPS} !=on
# RewriteCond %{HTTP:X-Forwarded-Proto} !https
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]


# --------------------------------------------------------------------
# 2. www.thermoconcept.by -> thermoconcept.by
# --------------------------------------------------------------------
# Один и тот же сайт, доступный по двум адресам, поисковик считает двумя
# разными сайтами и делит между ними доверие. Поэтому оставляем один
# основной адрес — без www, как в og:url и canonical (см. base.njk).
# 301 — постоянная переадресация, её поисковики учитывают и склеивают
# адреса; временная (302) этого не даёт.
#
# %{REQUEST_SCHEME} подставляет тот протокол, по которому пришёл запрос,
# поэтому правило одинаково корректно работает и до выпуска сертификата,
# и после — менять его потом не нужно.
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ %{REQUEST_SCHEME}://%1%{REQUEST_URI} [L,R=301]


# --------------------------------------------------------------------
# 3. Сжатие текстовых файлов
# --------------------------------------------------------------------
# Самый заметный выигрыш на этом сайте: style.15.css весит ~330 КБ, в
# сжатом виде уходит примерно в 6 раз меньше. Картинки, видео и шрифты
# (woff2) уже сжаты своими форматами — их повторно жать бессмысленно,
# только зря греть процессор, поэтому в списке их нет.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>


# --------------------------------------------------------------------
# 4. Кеширование в браузере
# --------------------------------------------------------------------
# Картинки, видео, шрифты, стили и скрипты кешируем надолго: при
# повторном заходе браузер берёт их с диска и не качает 65 МБ заново.
# Это безопасно, потому что при изменении мы переименовываем файл
# (style.14.css -> style.15.css) — браузер видит новый адрес и берёт
# свежую версию, а старый кеш просто перестаёт использоваться.
#
# HTML — наоборот, НЕ кешируем: имена страниц постоянны (/about/), и
# закешированная страница продолжала бы ссылаться на старый CSS. Именно
# из-за такого кеша на GitHub Pages правки часами не доезжали.
<IfModule mod_expires.c>
  ExpiresActive On

  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType image/x-icon            "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType video/mp4               "access plus 1 year"

  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>


# --------------------------------------------------------------------
# 5. Мелочи
# --------------------------------------------------------------------
# Кодировка по умолчанию — иначе редкие серверы отдают текстовые файлы
# в latin-1 и кириллица превращается в кракозябры.
AddDefaultCharset UTF-8

# Не показывать содержимое папки, если в ней вдруг не окажется
# index.html (по умолчанию Apache выводит список файлов — это и
# некрасиво, и лишняя информация наружу).
Options -Indexes
