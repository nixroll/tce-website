---
layout: base.njk
stickyHeader: true
headerTheme: light
hasContactForm: true
hasGallery: true
hasParallax: true
customSections: true
noindex: true
eleventyExcludeFromCollections: true
catalogView: products2
pagination:
  data: products2.pages
  size: 1
  alias: p2page
permalink: "/products2/{{ p2page.cat.slug }}/{{ p2page.brand.slug }}/"
eleventyComputed:
  title: "{{ p2page.brand.name }} (тест) - Thermo Concept Engineering"
  description: "{{ p2page.brand.name }} — оборудование от Thermo Concept Engineering: подбор, поставка напрямую от производителя, монтаж, пусконаладка и сервис."
