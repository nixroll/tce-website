<section class="areas" data-figma-node="491:2875" data-figma-name="Areas - L">
  <div class="areas__intro">
    <div class="areas__title-badge">
      <span class="areas__badge">Направления</span>
      <p class="areas__heading">Чем мы занимаемся. <span class="areas__heading-muted">Работы под ключ и прямые поставки.</span></p>
    </div>
  </div>
  <div class="areas__grid">
    <div class="areas__card areas__card--engineering">
      <div class="areas__image">
        <picture>
          <source
            type="image/webp"
            srcset="{{ '/images/areas/engineering-400.webp' | url }} 400w, {{ '/images/areas/engineering-700.webp' | url }} 700w, {{ '/images/areas/engineering-1000.webp' | url }} 1000w"
            sizes="(min-width: 1000px) 640px, (min-width: 768px) 320px, 326px">
          <img
            src="{{ '/images/areas/engineering-1000.jpg' | url }}"
            srcset="{{ '/images/areas/engineering-400.jpg' | url }} 400w, {{ '/images/areas/engineering-700.jpg' | url }} 700w, {{ '/images/areas/engineering-1000.jpg' | url }} 1000w"
            sizes="(min-width: 1000px) 640px, (min-width: 768px) 320px, 326px"
            width="615" height="460"
            alt="Инженерные работы"
            loading="lazy">
        </picture>
      </div>
      <div class="areas__content">
        <div class="areas__card-text">
          <p class="areas__card-title">Инженерные работы</p>
          <p class="areas__card-desc">Проектируем, поставляем, монтируем и обслуживаем. Весь инженерный проект от расчёта до сервиса в одних руках.</p>
        </div>
        <a class="areas__btn" href="{{ '/services/' | url }}">
          Услуги
          <svg class="areas__btn-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M4 12H20M20 12L14 6M20 12L14 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>
    <div class="areas__card areas__card--supply">
      <div class="areas__image">
        <picture>
          <source
            type="image/webp"
            srcset="{{ '/images/areas/supply-400.webp' | url }} 400w, {{ '/images/areas/supply-700.webp' | url }} 700w, {{ '/images/areas/supply-1000.webp' | url }} 1000w"
            sizes="(min-width: 1000px) 640px, (min-width: 768px) 320px, 326px">
          <img
            src="{{ '/images/areas/supply-1000.jpg' | url }}"
            srcset="{{ '/images/areas/supply-400.jpg' | url }} 400w, {{ '/images/areas/supply-700.jpg' | url }} 700w, {{ '/images/areas/supply-1000.jpg' | url }} 1000w"
            sizes="(min-width: 1000px) 640px, (min-width: 768px) 320px, 326px"
            width="615" height="460"
            alt="Поставка оборудования"
            loading="lazy">
        </picture>
      </div>
      <div class="areas__content">
        <div class="areas__card-text">
          <p class="areas__card-title">Поставка оборудования</p>
          <p class="areas__card-desc">Прямые поставки котельного и инженерного оборудования мировых брендов с полной гарантией и склад запчастей.</p>
        </div>
        <a class="areas__btn" href="{{ '/catalog/' | url }}">
          Каталог
          <svg class="areas__btn-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M4 12H20M20 12L14 6M20 12L14 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
