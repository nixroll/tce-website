    <div class="brands__cell brands__cell--wilo"><img src="{{ '/images/brands/wilo.svg' | url }}" alt="Wilo"></div>
    <div class="brands__cell brands__cell--flamco"><img src="{{ '/images/brands/flamco.svg' | url }}" alt="Flamco"></div>
