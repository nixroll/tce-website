  { n: "02", href: "https://drive.google.com/file/d/1ZYf9jo0vwanyjJmO7CEfIPp16Q-zl6d9/view", company: "ООО «АлюКойл» (ГК «Алютех»)", quote: "Поставка выполнена в&nbsp;срок и&nbsp;в&nbsp;полном объёме: по&nbsp;срокам и&nbsp;техническим характеристикам оборудования.", name: "—&nbsp;С.В.&nbsp;Янушко", role: "Директор, ООО&nbsp;«АлюКойл» (ГК&nbsp;«Алютех»)" },
  { n: "03", img: "03-v2", href: "https://drive.google.com/file/d/1QvRsUfwqvAg7AqM6pX4Hc066gFio66VT/view", company: "ИООО «Вило Бел»", quote: "Профессионализм и&nbsp;ответственность сотрудников позволили нам быстро решать производственные вопросы.", name: "—&nbsp;Е.&nbsp;Козусь", role: "Зам.&nbsp;директора, ИООО&nbsp;«Вило Бел»" },
  { n: "04", href: "https://drive.google.com/file/d/1EB8StM7frLLYyXvDBaCGCM9_eXVlsEQl/view", company: "ООО «Котлоэнергосервис-СМУ»", quote: "Благодарим за&nbsp;своевременную поставку котлов Schuster и&nbsp;горелок ELCO для&nbsp;котельной в&nbsp;Орше.", name: "—&nbsp;Д.В.&nbsp;Люкевич", role: "Директор, ООО&nbsp;«Котлоэнергосервис-СМУ»" },
  { n: "05", img: "05-v2", href: "https://drive.google.com/file/d/14axQY2EvWmZiXjZCLH6jXph9VfnBtBNj/view", company: "РУ «Райская поляна»", quote: "Консультации на&nbsp;этапе проекта, согласования и&nbsp;шеф-монтаж. Компания исполнила все договорные обязательства.", name: "—&nbsp;Л.А.&nbsp;Жигаревич", role: "Зам.&nbsp;директора, РУ&nbsp;«Райская поляна»" },
  { n: "06", href: "https://drive.google.com/file/d/1SSyzjvrSeate3VzHqSq2FCvMbqqYRuTt/view", company: "ООО «Гидробурсервис»", quote: "Каждая поставка очистных сооружений, ДНС и&nbsp;КНС выполнена в&nbsp;оговорённые сроки и&nbsp;с&nbsp;технической поддержкой.", name: "—&nbsp;В.А.&nbsp;Валынец", role: "Директор, ООО&nbsp;«Гидробурсервис»" },
  { n: "07", img: "07-v2", href: "https://drive.google.com/file/d/15G3Y8stRel8rf1kHW9d3oA9tlaBB6xQk/view", company: "ООО «Интерьеры 360»", quote: "Отмечаем индивидуальный подход сотрудников и&nbsp;оперативность в&nbsp;решении всех возникающих вопросов.", name: "—&nbsp;О.В.&nbsp;Подвальников", role: "Руководитель, ООО&nbsp;«Интерьеры&nbsp;360»" },
  { n: "08", href: "https://drive.google.com/file/d/14ZUoaZbT3vWEc_G5WiHaaVY_6KBiQT0p/view", company: "ООО «Табак-Инвест»", quote: "Рекомендуем компанию как&nbsp;надёжного и&nbsp;добросовестного поставщика и&nbsp;партнёра.", name: "—&nbsp;Ю.С.&nbsp;Кустанович", role: "Зам.&nbsp;директора, ООО&nbsp;«Табак-Инвест»" },
  { n: "09", href: "https://drive.google.com/file/d/10DiwVPeopnsXBw1BSEWJIv-qmxVAh26L/view", company: "ООО «ТеплоДизайнСервис»", quote: "Котельное оборудование поставлено точно в&nbsp;согласованные сроки, с&nbsp;квалифицированной технической поддержкой.", name: "—&nbsp;А.В.&nbsp;Гринкевич", role: "ООО&nbsp;«ТеплоДизайнСервис»" },
  { n: "10", img: "10-v2", href: "https://drive.google.com/file/d/1COOrPAZfq40iZuCYpGGhhCuI4Zzk_mVB/view", company: "ООО «Панкара Плюс»", quote: "Мы&nbsp;удовлетворены работой компании и&nbsp;рады рекомендовать её&nbsp;как&nbsp;надёжного и&nbsp;ответственного партнёра.", name: "—&nbsp;А.А.&nbsp;Каранец", role: "Директор, ООО&nbsp;«Панкара Плюс»" }
] %}
<section class="testimonial" data-figma-node="2443:11198" data-figma-name="Testimonial" aria-roledescription="carousel" aria-label="Благодарственные письма" data-testimonial>
  <div class="testimonial__container">
    <div class="testimonial__stage">
      <div class="testimonial__slides" aria-live="off" data-testimonial-slides>
        {%- for l in letters %}
        <article class="testimonial__slide{% if loop.first %} is-active{% endif %}" aria-roledescription="slide" aria-label="{{ loop.index }} из {{ letters | length }}"{% if not loop.first %} inert{% endif %} data-testimonial-slide>
          <div class="testimonial__content">
            <a class="testimonial__image" href="{{ l.href }}" target="_blank" rel="noopener" aria-label="Открыть скан письма {{ l.company }} в новой вкладке"{% if not loop.first %} tabindex="-1"{% endif %}>
              <picture class="testimonial__picture">
                <source type="image/webp" srcset="{{ ('/images/testimonials/letter-' + (l.img or l.n) + '-240.webp') | url }} 240w, {{ ('/images/testimonials/letter-' + (l.img or l.n) + '-480.webp') | url }} 480w" sizes="(min-width: 1000px) 172px, 105px">
                <img src="{{ ('/images/testimonials/letter-' + (l.img or l.n) + '-480.jpg') | url }}" srcset="{{ ('/images/testimonials/letter-' + (l.img or l.n) + '-240.jpg') | url }} 240w, {{ ('/images/testimonials/letter-' + (l.img or l.n) + '-480.jpg') | url }} 480w" sizes="(min-width: 1000px) 172px, 105px" width="480" height="679" alt="Благодарственное письмо {{ l.company }}" loading="lazy" decoding="async">
              </picture>
            </a>
            <div class="testimonial__body">
              <blockquote class="testimonial__quote">{{ l.quote | safe }}</blockquote>
              <div class="testimonial__attribution">
                <p class="testimonial__name">{{ l.name | safe }}</p>
                <p class="testimonial__role">{{ l.role | safe }}</p>
              </div>
            </div>
          </div>
        </article>
        {%- endfor %}
      </div>
      <div class="testimonial__dots" role="group" aria-label="Выбор письма" hidden data-testimonial-dots>
        {%- for l in letters %}
        <button class="testimonial__dot{% if loop.first %} is-active{% endif %}" type="button" aria-label="Письмо {{ loop.index }} из {{ letters | length }}"{% if loop.first %} aria-current="true"{% endif %}></button>
        {%- endfor %}
      </div>
    </div>
  </div>
</section>
