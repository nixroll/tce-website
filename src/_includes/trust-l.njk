{# Trust - L (Figma node 2362:7041) — светлая секция «Доверие» на /about/,
   между Team - L и Gallery - L (с Divider - L до и после, см. about.njk и
   Layout 1130:8714).

   Собрана на базе Stages - L (stages-l.njk): те же паддинги, типографика,
   сетка и хэйрлайны, только 3 карточки и в каждой — ссылка «Смотреть» на
   документ в Google Drive (открывается в новой вкладке). Колонки:
   1 / 1 / 2 / 3 / 3 на 320 / 390 / 768 / 1000 / 1440. На 768 у сетки из
   2 колонок остаётся пустая ячейка — её закрывает placeholder (в макете
   там тоже пустая карточка), чтобы хэйрлайны последней строки не рвались.
   CSS — в style.css у .trust-l. #}
{% set trustDocs = [
  { number: "01", title: "Буклет", text: "Каталог услуг, оборудования и&nbsp;реализованных проектов&nbsp;компании.", href: "https://drive.google.com/file/d/1tcAVg5yErI38c7CpSV3Qq4qDo_gOJrAJ/view?usp=drive_link", label: "буклет" },
  { number: "02", title: "Свидетельство", text: "Официальная регистрация товарного знака компании в&nbsp;Беларуси.", href: "https://drive.google.com/file/d/1fqWeYsn5E_t-aeGYLC5dvBQpl3slPbtt/view?usp=drive_link", label: "свидетельство" },
  { number: "03", title: "Сертификат", text: "Подтверждение регистрации и&nbsp;прав на&nbsp;домен&nbsp;thermoconcept.by.", href: "https://drive.google.com/file/d/1ruMQm0-lgcgqSWyKzmL9KzVfPWDh0Hs7/view?usp=drive_link", label: "сертификат" }
] %}
<section class="trust-l" data-figma-node="2362:7041" data-figma-name="Trust - L">
  <div class="trust-l__container">
    <div class="trust-l__title-badge">
      <span class="trust-l__badge">Доверие</span>
      <h2 class="trust-l__heading">Всё официально.<br>
        <span class="trust-l__heading-muted">Подтверждаем документами.</span>
      </h2>
    </div>
  </div>
  <div class="trust-l__grid">
    {%- for d in trustDocs %}
    <div class="trust-l__card">
      <p class="trust-l__card-number">{{ d.number }}</p>
      <div class="trust-l__card-content">
        <div class="trust-l__card-text-wrap">
          <h3 class="trust-l__card-title">{{ d.title }}</h3>
          <p class="trust-l__card-text">{{ d.text | safe }}</p>
        </div>
        <a class="trust-l__card-link" href="{{ d.href }}" target="_blank" rel="noopener" aria-label="Смотреть {{ d.label }} (откроется в новой вкладке)">Смотреть</a>
      </div>
    </div>
    {%- endfor %}
    <div class="trust-l__card trust-l__card--placeholder" aria-hidden="true"></div>
  </div>
</section>
